# Copy the names below into Vercel (Settings → Environment Variables). Values go only there, never in git.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). It is public by design: RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never add the secret / service_role key to this app.

# Optional. Shows the "Continuar com Google" button only when set to "true" (default: off).
# NEXT_PUBLIC_ variables are inlined at build time: changing it needs a new deploy.
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=

# Optional. Cloudflare Turnstile SITE key (public). Without it the login works as before. Read at build
# time (new deploy needed). The Turnstile SECRET key goes only in the Supabase dashboard, never here or in Vercel.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional, SERVER-only. "true" sends Content-Security-Policy-Report-Only instead of blocking (escape hatch:
# change it in Vercel and Redeploy). See README, "Cabeçalhos de segurança e CSP".
CSP_REPORT_ONLY=
